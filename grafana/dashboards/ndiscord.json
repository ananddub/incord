{
    "id": null,
    "uid": "ndiscord-main",
    "title": "ndiscord - Discord Clone",
    "tags": ["ndiscord"],
    "timezone": "browser",
    "refresh": "5s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "gRPC Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(ndiscord_grpc_request_duration_seconds_count[1m])) by (method)",
            "legendFormat": "{{method}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 2,
        "title": "gRPC Latency (p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(ndiscord_grpc_request_duration_seconds_bucket[1m])) by (le, method))",
            "legendFormat": "p99 {{method}}"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(ndiscord_grpc_request_duration_seconds_bucket[1m])) by (le, method))",
            "legendFormat": "p50 {{method}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 5 }
          }
        }
      },
      {
        "id": 3,
        "title": "Messages Sent",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
        "targets": [
          { "expr": "ndiscord_messages_sent_total", "legendFormat": "total" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "green", "value": null}] } }
        }
      },
      {
        "id": 4,
        "title": "Users Registered",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
        "targets": [
          { "expr": "ndiscord_users_registered_total", "legendFormat": "total" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "blue", "value": null}] } }
        }
      },
      {
        "id": 5,
        "title": "Guilds Created",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
        "targets": [
          { "expr": "ndiscord_guilds_created_total", "legendFormat": "total" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "purple", "value": null}] } }
        }
      },
      {
        "id": 6,
        "title": "Users Online",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
        "targets": [
          { "expr": "ndiscord_users_online", "legendFormat": "online" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}] }
          }
        }
      },
      {
        "id": 7,
        "title": "Active Streams",
        "type": "bargauge",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
        "targets": [
          { "expr": "ndiscord_active_streams", "legendFormat": "{{type}}" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short" }
        }
      },
      {
        "id": 8,
        "title": "Voice Participants",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
        "targets": [
          { "expr": "ndiscord_voice_participants", "legendFormat": "in voice" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}] }
          }
        }
      },
      {
        "id": 9,
        "title": "Events Published (rate/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "sum(rate(ndiscord_events_published_total[1m])) by (topic)",
            "legendFormat": "{{topic}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "bars", "fillOpacity": 50 }
          }
        }
      },
      {
        "id": 10,
        "title": "Events Consumed (rate/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "sum(rate(ndiscord_events_consumed_total[1m])) by (topic)",
            "legendFormat": "{{topic}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "bars", "fillOpacity": 50 }
          }
        }
      },
      {
        "id": 11,
        "title": "gRPC Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "sum(rate(ndiscord_grpc_request_duration_seconds_count{code!=\"OK\"}[1m])) by (code)",
            "legendFormat": "{{code}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 20 }
          }
        }
      },
      {
        "id": 12,
        "title": "Message Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "rate(ndiscord_messages_sent_total[1m])",
            "legendFormat": "sent/s"
          },
          {
            "expr": "rate(ndiscord_messages_deleted_total[1m])",
            "legendFormat": "deleted/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "line", "fillOpacity": 15 }
          }
        }
      },
      {
        "id": 13,
        "title": "Go Runtime",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "targets": [
          { "expr": "go_goroutines", "legendFormat": "goroutines" },
          { "expr": "go_threads", "legendFormat": "OS threads" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "drawStyle": "line" } }
        }
      },
      {
        "id": 14,
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "targets": [
          { "expr": "go_memstats_alloc_bytes", "legendFormat": "alloc" },
          { "expr": "go_memstats_sys_bytes", "legendFormat": "sys" },
          { "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap inuse" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
        }
      },
      {
        "id": 100,
        "type": "row",
        "title": "Logs",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
      },
      {
        "id": 101,
        "title": "Log Volume by Container",
        "type": "timeseries",
        "datasource": { "type": "loki", "uid": "loki" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
        "targets": [
          {
            "datasource": { "type": "loki", "uid": "loki" },
            "expr": "sum by (container) (count_over_time({container=~\"ndiscord-.+\"}[$__auto]))",
            "legendFormat": "{{container}}",
            "queryType": "range"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }
        }
      },
      {
        "id": 102,
        "title": "Error Log Rate",
        "type": "timeseries",
        "datasource": { "type": "loki", "uid": "loki" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
        "targets": [
          {
            "datasource": { "type": "loki", "uid": "loki" },
            "expr": "sum by (container) (count_over_time({container=~\"ndiscord-.+\"} |~ \"(?i)error|fatal|panic|ERR|FTL|PNC\" [$__auto]))",
            "legendFormat": "{{container}}",
            "queryType": "range"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20 }, "color": { "mode": "palette-classic" } }
        }
      },
      {
        "id": 103,
        "title": "Errors / Warnings (live)",
        "type": "logs",
        "datasource": { "type": "loki", "uid": "loki" },
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 45 },
        "targets": [
          {
            "datasource": { "type": "loki", "uid": "loki" },
            "expr": "{container=~\"ndiscord-.+\"} |~ \"(?i)error|fatal|panic|warn|ERR|FTL|PNC|WRN\"",
            "queryType": "range"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": false,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },
      {
        "id": 104,
        "title": "All Logs — $container",
        "type": "logs",
        "datasource": { "type": "loki", "uid": "loki" },
        "gridPos": { "h": 14, "w": 24, "x": 0, "y": 57 },
        "targets": [
          {
            "datasource": { "type": "loki", "uid": "loki" },
            "expr": "{container=\"$container\"}",
            "queryType": "range"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": false,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "container",
          "label": "Container",
          "type": "query",
          "datasource": { "type": "loki", "uid": "loki" },
          "query": { "label": "container", "stream": "{container=~\"ndiscord-.+\"}", "type": 1 },
          "refresh": 2,
          "includeAll": false,
          "multi": false,
          "current": { "text": "ndiscord-server", "value": "ndiscord-server" }
        }
      ]
    },
    "schemaVersion": 39
}
